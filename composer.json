{
    "name": "pbmedia/laravel-ffmpeg",
    "description": "FFMpeg for Laravel",
    "keywords": [
        "laravel",
        "laravel-ffmpeg",
        "ffmpeg",
        "protonemedia",
        "protone media"
    ],
    "homepage": "https://github.com/protonemedia/laravel-ffmpeg",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Pascal Baljet",
            "email": "pascal@protone.media",
            "homepage": "https://protone.media",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "laravel/framework": "^13.20",
        "laravel/serializable-closure": "^2.0"
    },
    "require-dev": {
        "intervention/image": "^4.2",
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.14",
        "league/flysystem-memory": "^3.10",
        "league/flysystem-path-prefixing": "^3.0",
        "league/flysystem-read-only": "^3.0",
        "mockery/mockery": "^1.4.4",
        "nesbot/carbon": "^2.66|^3.0",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^11.5.3|^12.5.12",
        "rector/rector": "^2.3"
    },
    "suggest": {
        "intervention/image": "Required to prepare images with prepareImage() (^4.2)."
    },
    "autoload": {
        "psr-4": {
            "ProtoneMedia\\LaravelFFMpeg\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ProtoneMedia\\LaravelFFMpeg\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "format": "vendor/bin/pint",
        "refactor": "vendor/bin/rector",
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "ProtoneMedia\\LaravelFFMpeg\\Support\\ServiceProvider"
            ],
            "aliases": {
                "FFMpeg": "ProtoneMedia\\LaravelFFMpeg\\Support\\FFMpeg"
            }
        }
    }
}
