#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Dependencies are installed during setup, never on resume.
for tool in php composer ffmpeg ffprobe; do
    command -v "$tool" >/dev/null
done
if [[ ! -f vendor/autoload.php ]]; then
    echo 'Composer dependencies are missing; run .agents/setup.' >&2
    exit 1
fi
